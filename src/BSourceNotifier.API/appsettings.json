{
  "Application": {
    "Name": "BSourceNotifier",
    "Environment": "Development"
  },
  "Cors": {
    "AllowedOriginHosts": [
      "localhost",
      "127.0.0.1",
      "192.167.0.1"
    ]
  },
  "Notification": {
    "Security": {
      "AuthorizedClients": []
    },
    "WebSocket": {
      "Enabled": true
    },
    "Email": {
      "Enabled": true,
      "From": "noreply@example.invalid",
      "Smtp": {
        "AuthenticationMode": "Credentials",
        "Host": "smtp.example.invalid",
        "Port": 587,
        "Username": "example-smtp-user",
        "Password": "replace-with-secret",
        "EnableSsl": true
      }
    },
    "Sms": {
      "Enabled": false
    },
    "Telegram": {
      "Enabled": false
    },
    "WhatsApp": {
      "Enabled": false
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning"
    }
  }
}
